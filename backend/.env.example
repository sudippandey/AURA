# Copy to .env and adjust. NEVER commit .env.
NODE_ENV=development
PORT=4000

# Local MongoDB (single node is fine for Stage 1; replica set required later for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/aura
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aura?retryWrites=true&w=majority

# Dev-only defaults exist in code, but set explicit values. Production REQUIRES strong secrets (>=32 chars).
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allowed origins (local Vite default + editor preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Global rate limit: max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

LOG_LEVEL=info
